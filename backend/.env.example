# ---- Dejoiy Mail backend env (copy to .env; NEVER commit .env) ----
NODE_ENV=development
PORT=4000

# Postgres (matches docker-compose defaults)
DATABASE_URL=postgres://dejoiy:dejoiy@localhost:5432/dejoiy_mail
POSTGRES_USER=dejoiy
POSTGRES_PASSWORD=dejoiy
POSTGRES_DB=dejoiy_mail
POSTGRES_PORT=5432

# Redis (optional at runtime; app falls back to in-memory if unreachable)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_ENABLED=true

# Auth
SESSION_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=30

# CORS (comma-separated origins; empty = reflect request origin)
CORS_ORIGIN=

# Seed (dev only)
SEED_ADMIN_PASSWORD=

# Mail provider: stub (default, queues only — nothing is delivered)
MAIL_PROVIDER=stub
MAIL_FROM_DOMAIN=workmail.dejoiy.com

# ---- Billing: Razorpay — STUB in MVP. Leave empty. ----
# The billing service refuses live operation until BILLING_LIVE=true AND both
# keys are set. Do not enable without reviewing services/billing.js.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
BILLING_LIVE=false
