{
 "id": "/",
 "name": "Dejoiy Mail",
 "short_name": "Dejoiy Mail",
 "description": "Business email on your own domain: colour-coded mail, labels, contacts and company updates, made for your phone.",
 "lang": "en-IN",
 "dir": "ltr",
 "start_url": "/?source=app",
 "scope": "/",
 "display": "standalone",
 "display_override": [
  "standalone",
  "minimal-ui"
 ],
 "orientation": "any",
 "background_color": "#FFFBF7",
 "theme_color": "#FF4FA3",
 "categories": [
  "business",
  "productivity"
 ],
 "icons": [
  {
   "src": "assets/icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "assets/icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "assets/icons/maskable-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "assets/icons/maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "assets/icons/monochrome-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "monochrome"
  }
 ],
 "shortcuts": [
  {
   "name": "Write a mail",
   "short_name": "Compose",
   "url": "/?source=shortcut#/compose:new",
   "icons": [
    {
     "src": "assets/icons/shortcut-compose.png",
     "sizes": "96x96",
     "type": "image/png"
    }
   ]
  },
  {
   "name": "Inbox",
   "url": "/?source=shortcut#/mail:inbox",
   "icons": [
    {
     "src": "assets/icons/shortcut-inbox.png",
     "sizes": "96x96",
     "type": "image/png"
    }
   ]
  },
  {
   "name": "Dejoiy Updates",
   "short_name": "Updates",
   "url": "/?source=shortcut#/news",
   "icons": [
    {
     "src": "assets/icons/shortcut-updates.png",
     "sizes": "96x96",
     "type": "image/png"
    }
   ]
  }
 ],
 "screenshots": [
  {
   "src": "assets/screens/mail-1-inbox.webp",
   "sizes": "1080x1920",
   "type": "image/webp",
   "form_factor": "narrow",
   "label": "Your inbox, colour-coded by label"
  },
  {
   "src": "assets/screens/mail-2-open-mail.webp",
   "sizes": "1080x1920",
   "type": "image/webp",
   "form_factor": "narrow",
   "label": "Every mail opens in its own colour"
  },
  {
   "src": "assets/screens/mail-3-compose.webp",
   "sizes": "1080x1920",
   "type": "image/webp",
   "form_factor": "narrow",
   "label": "Write with a label, or let Auto pick one"
  },
  {
   "src": "assets/screens/mail-5-updates.webp",
   "sizes": "1080x1920",
   "type": "image/webp",
   "form_factor": "narrow",
   "label": "News from Dejoiy and your company"
  }
 ],
 "launch_handler": {
  "client_mode": "navigate-existing"
 },
 "prefer_related_applications": false
}